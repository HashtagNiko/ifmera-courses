# Supabase-Zugangsdaten (Projekt "shnoozy-App" -> Settings -> API)
# Kopiere diese Datei zu ".env" und trage die Werte ein.
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
VITE_SUPABASE_ANON_KEY=dein-anon-public-key

# Konto fuer scripts/sync-decks.mjs. Das Skript meldet sich damit ganz normal an
# und fragt beim ersten Lauf einmal nach dem Passwort; danach reicht die Sitzung
# aus .sync-session.json. Ein service_role-Key wird bewusst nicht verwendet.
SUPABASE_EMAIL=deine@adresse.de

# Ordner, unter dem die Kursordner liegen. Welche Kurse es gibt und wie ihre
# Unterordner heissen, steht in kurse.config.json.
KURS_WURZEL=C:/Pfad/zu/Neukonzeption
